rules_version = '2';
// BOXBASE — only people listed in a home's `members` can read or write its boxes.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email_verified == true;
    }
    function me() { return request.auth.token.email.lower(); }
    function isMember(home) {
      return signedIn() && me() in get(/databases/$(database)/documents/homes/$(home)).data.members;
    }

    match /homes/{home} {
      allow read: if signedIn() && me() in resource.data.members;
      allow create: if signedIn()
        && home == request.auth.uid
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.ownerEmail == me()
        && request.resource.data.members == [me()];
      // any member can add/remove family; nobody can remove the owner or change ownership
      allow update: if signedIn() && me() in resource.data.members
        && request.resource.data.owner == resource.data.owner
        && request.resource.data.ownerEmail == resource.data.ownerEmail
        && resource.data.ownerEmail in request.resource.data.members
        && request.resource.data.members.size() <= 20;
      allow delete: if false;

      match /{coll}/{id} {
        allow read, write: if coll in ['boxes', 'items', 'images'] && isMember(home);
      }
    }
  }
}
